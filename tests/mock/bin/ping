#!/bin/sh
# MOCK_PING_OK="ip …" answer always; MOCK_PING_AFTER / MOCK_FIXED_IP answer once $MOCK_STATE/fixed exists
for a; do last="$a"; done
case "$last" in ff02::1%*) exit 1;; esac
if [ -f "$MOCK_STATE/fixed" ]; then
  case " ${MOCK_PING_AFTER:-} ${MOCK_FIXED_IP:-} " in *" $last "*) exit 0;; esac
fi
case " ${MOCK_PING_OK:-} " in *" $last "*) exit 0;; esac
exit 1
